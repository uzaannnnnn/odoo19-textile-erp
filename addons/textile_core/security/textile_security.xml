<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_textile" model="ir.module.category">
        <field name="name">Textile</field>
        <field name="description">Textile ERP Access Control</field>
        <field name="sequence">20</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_textile">
        <field name="name">Textile</field>
        <field name="category_id" ref="module_category_textile"/>
    </record>

    <!-- Base User Group -->
    <record id="group_textile_user" model="res.groups">
        <field name="name">Textile User</field>
        <field name="privilege_id" ref="res_groups_privilege_textile"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Role Groups -->
    <record id="group_textile_sales" model="res.groups">
        <field name="name">Textile Sales</field>
        <field name="privilege_id" ref="res_groups_privilege_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_textile_user'))]"/>
    </record>

    <record id="group_textile_ppic" model="res.groups">
        <field name="name">Textile PPIC</field>
        <field name="privilege_id" ref="res_groups_privilege_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_textile_user'))]"/>
    </record>

    <record id="group_textile_production" model="res.groups">
        <field name="name">Textile Production</field>
        <field name="privilege_id" ref="res_groups_privilege_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_textile_user'))]"/>
    </record>

    <record id="group_textile_qc" model="res.groups">
        <field name="name">Textile QC</field>
        <field name="privilege_id" ref="res_groups_privilege_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_textile_user'))]"/>
    </record>

    <record id="group_textile_warehouse" model="res.groups">
        <field name="name">Textile Warehouse</field>
        <field name="privilege_id" ref="res_groups_privilege_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_textile_user'))]"/>
    </record>

    <!-- Manager Group -->
    <record id="group_textile_manager" model="res.groups">
        <field name="name">Textile Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_textile"/>
        <field name="implied_ids" eval="[
            (4, ref('group_textile_sales')),
            (4, ref('group_textile_ppic')),
            (4, ref('group_textile_production')),
            (4, ref('group_textile_qc')),
            (4, ref('group_textile_warehouse'))
        ]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
