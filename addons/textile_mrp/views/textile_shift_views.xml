<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shift List View -->
    <record id="view_textile_shift_list" model="ir.ui.view">
        <field name="name">textile.shift.list</field>
        <field name="model">textile.shift</field>
        <field name="arch" type="xml">
            <list string="Textile Shifts">
                <field name="code"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Shift Form View -->
    <record id="view_textile_shift_form" model="ir.ui.view">
        <field name="name">textile.shift.form</field>
        <field name="model">textile.shift</field>
        <field name="arch" type="xml">
            <form string="Textile Shift">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Shift Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Shift A"/>
                        </h1>
                    </div>
                    <group>
                        <field name="code" placeholder="e.g. SHIFT-A"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Shift Action -->
    <record id="action_textile_shift" model="ir.actions.act_window">
        <field name="name">Production Shifts</field>
        <field name="res_model">textile.shift</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your factory shifts
            </p>
        </field>
    </record>

    <!-- Menu Item for Shifts under Configuration -->
    <menuitem id="menu_textile_shifts"
              name="Shifts"
              parent="textile_core.menu_textile_configuration"
              sequence="10"
              action="action_textile_shift"
              groups="textile_core.group_textile_manager"/>
</odoo>
